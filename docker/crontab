# ==============================================================================
# QUANT SCANNER SCHEDULES (container-local)
# Cron Format: [Min] [Hour] [Day-of-Month] [Month] [Day-of-Week] [User] [Command]
# Times are America/New_York (container TZ).
# Host crontab also runs docker exec jobs — keep schedules aligned.
# ==============================================================================

# Mon–Fri 5:47 PM ET — daily breakout scan, archive, and email
47 17 * * 1-5 root . /etc/environment; quant-daily >> /app/logs/cron.log 2>&1

# Fri 6:17 PM ET — Peter Lynch weekly scan, archive, and email
17 18 * * 5 root . /etc/environment; quant-lynch --report both --archive >> /app/logs/cron.log 2>&1
